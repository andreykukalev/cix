# Copy to .env (git-ignored) or let the scripts write it. No secrets here: keys live in secrets/ as files.

# Claude token expiry (tools/setup-secrets.ps1 writes it), for the trader's warning.
CLAUDE_TOKEN_EXPIRES=2027-10-25

# Agents (defaults shown)
TRADER_MODEL=sonnet
ANALYST_MODEL=opus
# TRADER_HEARTBEAT_MINUTES=240
# TRADER_MIN_GAP_MINUTES=15
# TRADER_MAX_RUNS_PER_DAY=30
# ANALYST_INTERVAL_HOURS=6
# ANALYST_WEB_DOMAINS=reuters.com,coindesk.com,federalreserve.gov
# CLAUDE_CODE_VERSION=2.1.0

# Azure Cosmos DB, only with docker-compose.azure.yml (tools/azure/provision.ps1 writes these)
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=cix
