  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cix.Domain\Cix.Domain.csproj" />
    <ProjectReference Include="..\Cix.Exchange.RevolutX\Cix.Exchange.RevolutX.csproj" />
  </ItemGroup>
</Project>
